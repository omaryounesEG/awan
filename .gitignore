# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# ---------------------------------------------------------------- added
# Build output and releases never belong in git: the .apk in dist/ is a
# release asset, not source, and it is 93 MB.
/dist/
/android/.gradle/
/android/app/build/
/android/local.properties
/ios/Pods/
/ios/.symlinks/
/ios/Flutter/Generated.xcconfig
/ios/Flutter/flutter_export_environment.sh

# Signing material must never be committed.
*.jks
*.keystore
key.properties
*.p12
*.mobileprovision

# Data pipelines download into these; they are caches, not sources.
/tools/cdn/
/tools/cdn_v2/
/tools/newbooks/
/tools/stage/
/tools/openiti_sample/
/tools/_fixture.py
/build_rec.log
/build_*.log

# Local experiments
*.orig
*.rej

# QA screenshot dump (390+ files, ~94 MB) — kept out of the repo.
/docs/screens/
