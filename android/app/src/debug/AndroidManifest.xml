<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Debug only: the library CDN runs off the developer's machine over plain
         HTTP (10.0.2.2 is the emulator's route to the host loopback). The release
         manifest keeps the platform default, so nothing that ships allows
         cleartext. `dart:io` sockets are not subject to that policy, which is why
         the downloads worked before this was wired up — this makes the allowance
         explicit for the day a WebView or an image loader needs the same host.
    -->
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
